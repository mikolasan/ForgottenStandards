<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Custom OpenGL View Container -->
    <FrameLayout
        android:id="@+id/calendar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <xyz.neupokoev.forgottenstandards.advanced.GlView
            android:id="@+id/calendar_gl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Dynamic TextViews for months will be added here -->

    </FrameLayout>

    <!-- 2. Info Panels Overlay -->
    <LinearLayout
        android:id="@+id/info_panels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Slavic Info Panel -->
        <LinearLayout
            android:id="@+id/slavic_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel_back"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/slavic_info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/font"
                android:textSize="16sp"
                android:text="---" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="8dp" />

        <!-- Gregorian Info Panel -->
        <LinearLayout
            android:id="@+id/gregorian_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/input_back"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/gregorian_info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fontPrimary"
                android:textSize="16sp"
                android:text="---" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>